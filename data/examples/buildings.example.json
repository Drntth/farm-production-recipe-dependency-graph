    },

    "description": {
      "type": "string",
      "description": "Opcionális leírás",
      "example": "Processes milk into dairy products"
    }
  },

  "example_object": {
    "id": "dairy",
    "name": "Dairy",
    "type": "production",
    "description": "Processes milk into dairy products"
  }
