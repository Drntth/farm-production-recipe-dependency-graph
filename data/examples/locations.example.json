{
  "schema": "Location",
  "fields": {
    "id": {
      "type": "string",
      "description": "Unique identifier (snake_case English)",
      "example": "dairy"
    },
    "name": {
      "type": "string",
      "description": "Display name",
      "example": "Dairy"
    },
    "type": {
      "type": "enum",
      "description": "Location category – everything that occupies space on the farm",
      "allowed_values": [
        "production",
        "animal",
        "field",
        "tree",
        "bush",
        "storage",
        "other"
      ],
      "example": "production"
    },
    "unlock_level": {
      "type": "integer",
      "description": "Minimum player level required to unlock",
      "example": 6
    }
  },
  "example_object": {
    "id": "dairy",
    "name": "Dairy",
    "type": "production",
    "unlock_level": 6
  }
}
