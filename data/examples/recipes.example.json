{
  "schema": "Recipe",
  "fields": {
    "id": {
      "type": "string",
      "description": "Unique recipe identifier (snake_case English)",
      "example": "cream"
    },
    "name": {
      "type": "string",
      "description": "Name of the produced item",
      "example": "Cream"
    },
    "location_id": {
      "type": "string",
      "description": "ID of the production location where this recipe is crafted",
      "example": "dairy"
    },
    "unlock_level": {
      "type": "integer",
      "description": "Minimum player level required to unlock the recipe",
      "example": 6
    },
    "inputs": {
      "type": "array",
      "description": "List of required resources",
      "items": {
        "resource_id": {
          "type": "string",
          "description": "Resource ID",
          "example": "milk"
        },
        "amount": {
          "type": "integer",
          "description": "Required quantity",
          "example": 1
        }
      }
    },
    "output": {
      "type": "object",
      "description": "Produced resource",
      "resource_id": {
        "type": "string",
        "description": "Produced resource ID",
        "example": "cream"
      },
      "amount": {
        "type": "integer",
        "description": "Produced quantity",
        "example": 1
      }
    }
  },
  "example_object": {
    "id": "cream",
    "name": "Cream",
    "location_id": "dairy",
    "unlock_level": 6,
    "inputs": [
      {
        "resource_id": "milk",
        "amount": 1
      }
    ],
    "output": {
      "resource_id": "cream",
      "amount": 1
    }
  }
}
