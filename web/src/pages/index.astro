---
import LevelPicker from "../components/LevelPicker.svelte";
import Base from "../layouts/Base.astro";
import { hours, loadIndex, url } from "../data";

const index = loadIndex();
const levels = index.levels.map((row) => row.level);
---

<Base title="Farm production planner">
  <h1>Level recommendations</h1>
  <p>
    For every player level: what to produce, what to do at each login and where to place the buildings. Each
    recommendation is for a player who bought nothing beyond the level (level defaults, no mastery, barn and silo
    not set), laid out on the starting farm area.
  </p>
  <p class="muted">
    From about level 36 on, not every block fits on the starting farm area: the "Not placed" column counts them.
    Which farm plots to unlock comes in a later version.
  </p>
  <LevelPicker client:load levels={levels} base={import.meta.env.BASE_URL} />
  <h2>All levels</h2>
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>Level</th>
          <th class="num">Login every</th>
          <th class="num">Blocks</th>
          <th class="num">Not placed</th>
        </tr>
      </thead>
      <tbody>
        {
          index.levels.map((row) => (
            <tr>
              <td>
                <a href={url(`levels/${row.level}/`)}>Level {row.level}</a>
              </td>
              <td class="num">{hours(row.login_interval_hours)}</td>
              <td class="num">{row.blocks}</td>
              <td class="num">{row.blocks_not_placed || ""}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
  <p class="muted">
    Game version {index.game_version ?? "?"}, planner {index.core_version ?? "?"}.
  </p>
</Base>
