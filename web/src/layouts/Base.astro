---
// Page frame: head (title, description, hreflang), theme before first paint,
// background, header, main, footer. The pattern of the portfolio site.
import "../styles/global.css";
import "@fontsource-variable/fredoka";
import "@fontsource-variable/nunito";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { url } from "../data";
import { content, LANGS, switchPath, type Lang } from "../i18n";

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
}
const { lang, title, description } = Astro.props;
const c = content(lang);
const pageTitle = title ? `${title} - ${c.meta.siteName}` : c.meta.siteName;
const alternate = (l: Lang) => new URL(switchPath(Astro.url.pathname, l), Astro.site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description ?? c.meta.description} />
    <meta name="theme-color" content="#3b7310" />
    <title>{pageTitle}</title>
    <link rel="icon" href={url("favicon.svg")} type="image/svg+xml" />
    <link rel="icon" href={url("favicon-32.png")} type="image/png" sizes="32x32" />
    <link rel="icon" href={url("favicon-192.png")} type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href={url("apple-touch-icon.png")} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    {LANGS.map((l) => <link rel="alternate" hreflang={l} href={alternate(l)} />)}
    <link rel="alternate" hreflang="x-default" href={alternate("en")} />
    <script is:inline>
      // stored choice first, else the system setting; before paint, so no flash
      let stored = null;
      try {
        stored = localStorage.getItem("theme");
      } catch {}
      const dark = stored ? stored === "dark" : matchMedia("(prefers-color-scheme: dark)").matches;
      document.documentElement.classList.toggle("dark", dark);
    </script>
  </head>
  <body class="flex min-h-screen flex-col antialiased">
    <a href="#main" class="skip-link">{c.ui.skip}</a>
    <div class="bg-glows" aria-hidden="true"></div>
    <Header lang={lang} />
    <main id="main" class="container-page flex-1 py-8 sm:py-12">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
