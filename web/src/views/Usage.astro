---
// "Usage": the web app first (level pages, My farms, export as the backup, the iOS home-screen
// help), the command-line tools in a closed section. Details stay in the repository docs.
import { Icon } from "astro-icon/components";
import Base from "../layouts/Base.astro";
import { content, localePath, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = content(lang);
const t = c.usage;
const REPO = "https://github.com/Drntth/farm-production-recipe-dependency-graph";
const DOCS = `${REPO}/blob/main/docs`;
const webCards = [
  {
    icon: "lucide:layout-grid",
    title: t.levelsTitle,
    text: t.levelsText,
    href: localePath(lang, "/"),
    link: t.levelsLink,
  },
  {
    icon: "lucide:tractor",
    title: t.farmsTitle,
    text: t.farmsText,
    href: localePath(lang, "profiles/"),
    link: t.farmsLink,
  },
  { icon: "lucide:download", title: t.exportTitle, text: t.exportText, href: undefined, link: undefined },
];
const steps = [
  {
    icon: "lucide:download",
    title: t.installTitle,
    text: t.installText,
    code: `git clone ${REPO}.git\ncd farm-production-recipe-dependency-graph\npython -m venv venv && source venv/bin/activate\npip install -r requirements.txt`,
  },
  { icon: "lucide:user-round", title: t.wizardTitle, text: t.wizardText, code: "python -m src wizard" },
  { icon: "lucide:map", title: t.mapTitle, text: t.mapText, code: "xdg-open tools/farm_map_editor.html" },
  { icon: "lucide:play", title: t.runTitle, text: t.runText, code: "python -m src all" },
];
const links = [
  { href: `${DOCS}/user-guide.md`, label: t.guide },
  { href: `${DOCS}/cli.md`, label: t.cli },
  { href: `${DOCS}/settings.md`, label: t.settings },
];
---

<Base lang={lang} title={t.title}>
  <h1 class="text-3xl sm:text-4xl">
    <span class="text-gradient">{t.title}</span>
  </h1>
  <p class="mt-4">{t.intro}</p>

  <section class="mt-10" aria-labelledby="web-app">
    <h2 id="web-app" class="section-title text-2xl">
      {t.webTitle}
    </h2>
    <ul class="mt-6 grid gap-4 md:grid-cols-3">
      {webCards.map((w) => (
        <li class="card reveal min-w-0 p-5">
          <div class="flex items-center gap-3">
            <Icon name={w.icon} class="size-5 text-accent" aria-hidden="true" />
            <h3 class="text-xl">{w.title}</h3>
          </div>
          <p class="mt-3 text-sm">{w.text}</p>
          {w.href && (
            <a
              href={w.href}
              class="mt-3 inline-flex items-center gap-2 text-sm text-accent underline underline-offset-2"
            >
              {w.link}
              <Icon name="lucide:arrow-right" class="size-4" aria-hidden="true" />
            </a>
          )}
        </li>
      ))}
    </ul>

    <details class="card reveal mt-6 p-5">
      <summary class="cursor-pointer font-display text-lg font-semibold">{t.iosTitle}</summary>
      <p class="mt-3 text-sm">{t.iosText}</p>
    </details>
  </section>

  <details class="card reveal mt-10 p-5" data-testid="cli-section">
    <summary class="cursor-pointer">
      <span class="font-display text-xl font-semibold">{t.cliTitle}</span>
      <span class="muted mt-1 block text-sm">{t.cliText}</span>
    </summary>
    <ol class="mt-6 grid gap-4 md:grid-cols-2">
      {steps.map((s, i) => (
        <li class="card min-w-0 p-5">
          <div class="flex items-center gap-3">
            <span class="step-no">{i + 1}</span>
            <Icon name={s.icon} class="size-5 text-accent" aria-hidden="true" />
            <h3 class="text-xl">{s.title}</h3>
          </div>
          <p class="mt-3 text-sm">{s.text}</p>
          <pre class="code mt-3" tabindex="0"><code>{s.code}</code></pre>
        </li>
      ))}
    </ol>
    <p class="muted mt-6 text-sm">
      {t.more}
      {links.map((l, i) => (
        <>
          {i > 0 && ", "}
          <a href={l.href} class="text-accent underline underline-offset-2">
            {l.label}
          </a>
        </>
      ))}
    </p>
  </details>
</Base>
