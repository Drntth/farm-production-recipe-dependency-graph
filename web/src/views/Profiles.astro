---
// "My farms": the farm profiles kept in this browser and their production plans
// (FarmProfiles island; Pyodide loads only on the first calculation).
import FarmProfiles from "../components/FarmProfiles.svelte";
import Base from "../layouts/Base.astro";
import { content, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = content(lang).profiles;
---

<Base lang={lang} title={t.title}>
  <section class="card p-5 sm:p-6">
    <h1 class="text-3xl sm:text-4xl">
      <span class="text-gradient">{t.title}</span>
    </h1>
    <p class="mt-3 max-w-3xl">{t.intro}</p>
  </section>
  <FarmProfiles client:only="svelte" lang={lang} />
</Base>
