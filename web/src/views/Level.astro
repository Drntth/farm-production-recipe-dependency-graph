---
// One level page in one language: header card with key figures and
// the ‹ N › switch, then layout → actions per login → plan details → upcoming,
// and a card to the next level. Game item names stay English (label()).
import { Icon } from "astro-icon/components";
import LevelPicker from "../components/LevelPicker.svelte";
import Base from "../layouts/Base.astro";
import { label, loadLevel, url, type LoginAction, type LoginItem } from "../data";
import { content, fill, hours, localePath, number, type Lang } from "../i18n";

interface Props {
  lang: Lang;
  level: number;
  levels: number[];
  prev?: number;
  next?: number;
}
const { lang, level, levels, prev, next } = Astro.props;
const c = content(lang);
const t = c.level;
const rec = loadLevel(level);
const comb = rec.combined;
const s = comb.schedule;
const blockName = new Map(comb.blocks.map((b) => [b.id, b.name]));
const notPlaced = rec.blocks_not_placed.map((id) => blockName.get(id) ?? label(id));
const trees = Object.entries(s.recommendations.trees_and_bushes);
const external = Object.entries(s.external_per_day);
const svg = url(`layouts/${level}.svg`);
const actions: Record<string, string> = c.actions;
const whats: Record<string, string> = c.whats;
const title = fill(t.title, { n: level });
const levelPath = (n: number) => localePath(lang, `levels/${n}/`);

const buildings = comb.blocks.flatMap((b) => b.locations).filter((l) => l.id !== "field");
const keys = [
  { icon: "lucide:blocks", name: t.keyBlocks, value: String(comb.summary.blocks) },
  { icon: "lucide:warehouse", name: t.keyBuildings, value: String(buildings.reduce((sum, l) => sum + l.copies, 0)) },
  { icon: "lucide:clock", name: t.keyLogins, value: number(s.logins_per_day, lang) },
];
const figures = [
  [t.loginEvery, hours(comb.summary.login_interval_hours, lang)],
  [t.loginsPerDay, number(s.logins_per_day, lang)],
  [t.productionHours, number(comb.summary.production_hours_per_hour, lang, 2)],
  [t.fieldsUsed, fill(t.fieldsOf, { used: s.recommendations.fields.used_by_plan, owned: s.recommendations.fields.owned })],
];

// one step card per action kind, in the planner's order; feed and queue list each building inside
const steps: { action: string; list: LoginAction[] }[] = [];
for (const a of s.actions_per_login) {
  const last = steps.at(-1);
  if (last && last.action === a.action) last.list.push(a);
  else steps.push({ action: a.action, list: [a] });
}
const half = new Set(["collect", "feed"]);
const itemName = (item: LoginItem) => label(item.recipe_id ?? item.resource_id ?? "?");
---

<Base lang={lang} title={title}>
  <section class="card p-5 sm:p-6">
    <div class="flex flex-wrap items-center justify-between gap-4">
      <h1 class="text-3xl sm:text-4xl"><span class="text-gradient">{title}</span></h1>
      <nav class="flex items-center gap-2" aria-label={t.nav}>
        {
          prev ? (
            <a href={levelPath(prev)} class="icon-btn" aria-label={fill(t.prev, { n: prev })} title={fill(t.prev, { n: prev })}>
              <Icon name="lucide:chevron-left" class="size-4" aria-hidden="true" />
            </a>
          ) : (
            <span class="icon-btn opacity-40" aria-hidden="true">
              <Icon name="lucide:chevron-left" class="size-4" />
            </span>
          )
        }
        <LevelPicker
          client:load
          compact
          levels={levels}
          base={localePath(lang, "levels/")}
          current={level}
          labels={{ label: c.picker.label, show: c.picker.show }}
        />
        {
          next ? (
            <a href={levelPath(next)} class="icon-btn" aria-label={fill(t.next, { n: next })} title={fill(t.next, { n: next })}>
              <Icon name="lucide:chevron-right" class="size-4" aria-hidden="true" />
            </a>
          ) : (
            <span class="icon-btn opacity-40" aria-hidden="true">
              <Icon name="lucide:chevron-right" class="size-4" />
            </span>
          )
        }
      </nav>
    </div>
    <dl class="mt-5 grid grid-cols-3 gap-3" data-testid="key-figures">
      {
        keys.map((k) => (
          <div class="tile flex items-center gap-3">
            <Icon name={k.icon} class="hidden size-6 shrink-0 text-accent sm:block" aria-hidden="true" />
            <div>
              <dt class="muted text-xs sm:text-sm">{k.name}</dt>
              <dd class="font-display text-2xl font-semibold">{k.value}</dd>
            </div>
          </div>
        ))
      }
    </dl>
  </section>

  <section class="card mt-8 p-4 sm:p-6" aria-labelledby="layout">
    <h2 id="layout" class="section-title text-2xl">{t.layout}</h2>
    {
      notPlaced.length > 0 && (
        <p class="warning mt-4" data-testid="not-placed">
          {fill(t.notPlaced, { n: notPlaced.length, names: notPlaced.join(", ") })}
        </p>
      )
    }
    <a href={svg} class="mt-4 block overflow-hidden rounded-xl border border-line bg-white">
      <img src={svg} alt={fill(t.layoutAlt, { n: level })} class="layout block h-auto w-full" loading="lazy" />
    </a>
    <p class="muted mt-2 text-sm">{t.zoom}</p>
    <ul class="mt-6 grid gap-3 sm:grid-cols-2 xl:grid-cols-3" data-testid="blocks">
      {
        comb.blocks.map((b) => (
          <li class="tile">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <h3 class="text-lg">{b.name}</h3>
              {!b.placed && <span class="badge badge-warn">{t.notPlacedTag}</span>}
            </div>
            <ul class="item-list mt-2">
              {b.locations.map((l) => (
                <li class="item">
                  {l.name} <b>×{l.copies}</b>
                </li>
              ))}
            </ul>
            {b.fields && b.fields.count > 0 && (
              <p class="muted mt-2 text-sm">
                <Icon name="lucide:wheat" class="mr-1 inline size-4 align-[-3px]" aria-hidden="true" />
                {fill(t.blockFields, { n: b.fields.count })}
                {b.fields.crops.length > 0 && <>: {b.fields.crops.map(label).join(", ")}</>}
              </p>
            )}
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mt-10" aria-labelledby="logins">
    <h2 id="logins" class="section-title text-2xl">{t.logins}</h2>
    <ol class="actions mt-6 grid gap-4 md:grid-cols-2">
      {
        steps.map((step, i) => (
          <li class:list={["card p-4 sm:p-5", !half.has(step.action) && "md:col-span-2"]}>
            <div class="flex items-center gap-3">
              <span class="step-no">{i + 1}</span>
              <h3 class="text-xl">{actions[step.action] ?? label(step.action)}</h3>
            </div>
            {step.list.length === 1 && !step.list[0].location_id ? (
              <div class="mt-3">
                {step.list[0].what && <p>{whats[step.list[0].what] ?? step.list[0].what}</p>}
                {step.list[0].items && (
                  <ul class="item-list">
                    {step.list[0].items.map((item) => (
                      <li class="item">
                        {itemName(item)} <b>{item.count ?? item.per_login}</b>
                        {item.every_n_logins && <span class="every">{fill(t.everyN, { n: item.every_n_logins })}</span>}
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            ) : (
              <ul
                class:list={[
                  "mt-3 grid gap-2",
                  half.has(step.action) ? "sm:grid-cols-2" : "sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4",
                ]}
              >
                {step.list.map((a) => (
                  <li class="tile p-3">
                    <p class="font-semibold">
                      {a.location_id ? label(a.location_id) : ""}
                      {a.slots ? <span class="muted text-xs font-normal"> · {fill(t.slots, { n: a.slots })}</span> : null}
                    </p>
                    {a.what && <p class="text-sm">{whats[a.what] ?? a.what}</p>}
                    {a.items && (
                      <ul class="item-list mt-2">
                        {a.items.map((item) => (
                          <li class="item">
                            {itemName(item)} <b>{item.count ?? item.per_login}</b>
                            {item.every_n_logins && (
                              <span class="every">{fill(t.everyN, { n: item.every_n_logins })}</span>
                            )}
                          </li>
                        ))}
                      </ul>
                    )}
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))
      }
    </ol>
  </section>

  <section class="card mt-10 p-4 sm:p-6" aria-labelledby="summary">
    <h2 id="summary" class="section-title text-2xl">{t.plan}</h2>
    <dl class="mt-4 grid grid-cols-2 gap-3 lg:grid-cols-4">
      {
        figures.map(([name, value]) => (
          <div class="tile">
            <dt class="muted text-sm">{name}</dt>
            <dd class="font-display text-xl font-semibold">{value}</dd>
          </div>
        ))
      }
    </dl>
    {
      trees.length > 0 && (
        <p class="mt-4">
          {t.trees} {trees.map(([id, tree]) => `${label(id)} ${tree.plants}`).join(", ")}.
        </p>
      )
    }
    {
      external.length > 0 && (
        <p class="mt-2">
          {t.external} {external.map(([id, n]) => `${label(id)} ${number(n, lang)}`).join(", ")}.
        </p>
      )
    }
  </section>

  {
    comb.expansion.upcoming.length > 0 && (
      <section class="card mt-8 p-4 sm:p-6" aria-labelledby="upcoming">
        <h2 id="upcoming" class="section-title text-2xl">
          {fill(t.upcoming, { n: comb.expansion.lookahead_levels })}
        </h2>
        <ul class="item-list mt-4">
          {comb.expansion.upcoming.map((u) => (
            <li class="item">{fill(t.upcomingItem, { level: u.unlock_level, name: label(u.location_id), count: u.count })}</li>
          ))}
        </ul>
      </section>
    )
  }

  {
    next && (
      <a href={levelPath(next)} class="tile mt-8 flex items-center justify-between gap-4" data-testid="next-level">
        <span>
          <span class="font-display text-xl font-semibold">{fill(t.nextLevel, { n: next })}</span>
          <span class="muted mt-1 block text-sm">{t.nextLevelText}</span>
        </span>
        <Icon name="lucide:arrow-right" class="size-6 shrink-0 text-accent" aria-hidden="true" />
      </a>
    )
  }
</Base>
