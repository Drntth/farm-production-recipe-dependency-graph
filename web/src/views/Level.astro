---
// One level page in one language, one of two tabs. Both: header card with
// key figures, the ‹ N › switch (stays on the open tab) and the tab links.
// layout (/levels/N/): farm view with the block cards → plan summary → upcoming; plan
// (/levels/N/plan/): plan summary with the login times → login actions per building,
// collapsed. Then a card to the
// next level on the same tab. Game item names stay English (label()).
import { Icon } from "astro-icon/components";
import FarmView from "../components/FarmView.svelte";
import LevelPicker from "../components/LevelPicker.svelte";
import Base from "../layouts/Base.astro";
import { label, loadLevel, loadMap, url, type LoginAction, type LoginItem } from "../data";
import { content, fill, hours, localePath, number, type Lang } from "../i18n";

interface Props {
  lang: Lang;
  level: number;
  levels: number[];
  prev?: number;
  next?: number;
  tab: Tab;
}
type Tab = "layout" | "plan";
const { lang, level, levels, prev, next, tab } = Astro.props;
const c = content(lang);
const t = c.level;
const rec = loadLevel(level);
const comb = rec.combined;
const s = comb.schedule;
const blockName = new Map(comb.blocks.map((b) => [b.id, b.name]));
const notPlaced = rec.blocks_not_placed.map((id) => blockName.get(id) ?? label(id));
const trees = Object.entries(s.recommendations.trees_and_bushes);
const external = Object.entries(s.external_per_day);
const svg = url(`layouts/${level}.svg`);
const actions: Record<string, string> = c.actions;
const whats: Record<string, string> = c.whats;
const title = fill(t.title, { n: level });
const suffix = tab === "plan" ? "plan/" : "";
const tabPath = (n: number, to: Tab) => localePath(lang, `levels/${n}/${to === "plan" ? "plan/" : ""}`);
const levelPath = (n: number) => tabPath(n, tab);
const tabs = [
  { id: "layout" as const, name: t.tabLayout, icon: "lucide:map" },
  { id: "plan" as const, name: t.tabPlan, icon: "lucide:list-checks" },
];
const pageTitle = tab === "plan" ? fill(t.planTitle, { n: level }) : title;

const buildings = comb.blocks.flatMap((b) => b.locations).filter((l) => l.id !== "field");
const keys = [
  { icon: "lucide:blocks", name: t.keyBlocks, value: String(comb.summary.blocks) },
  { icon: "lucide:warehouse", name: t.keyBuildings, value: String(buildings.reduce((sum, l) => sum + l.copies, 0)) },
  { icon: "lucide:clock", name: t.keyLogins, value: number(s.logins_per_day, lang) },
];
const brief = [
  [t.loginsPerDay, number(s.logins_per_day, lang)],
  [
    t.fieldsUsed,
    fill(t.fieldsOf, { used: s.recommendations.fields.used_by_plan, owned: s.recommendations.fields.owned }),
  ],
  [t.productionHours, number(comb.summary.production_hours_per_hour, lang, 2)],
];
const figures = [
  [t.loginsPerDay, number(s.logins_per_day, lang)],
  [t.dayGap, hours(s.day_gap_hours, lang)],
  [t.nightGap, hours(s.night_gap_hours, lang)],
  [t.productionHours, number(comb.summary.production_hours_per_hour, lang, 2)],
  [
    t.fieldsUsed,
    fill(t.fieldsOf, { used: s.recommendations.fields.used_by_plan, owned: s.recommendations.fields.owned }),
  ],
];

// login actions grouped by building in the planner's order; collect, plant and sell have no
// building and form a group of their own
interface Group {
  id: string;
  name: string;
  kind?: string;
  slots?: number;
  list: LoginAction[];
}
const groups: Group[] = [];
for (const a of s.actions_per_login) {
  const id = a.location_id ?? a.action;
  const group = groups.find((g) => g.id === id);
  if (group) {
    group.list.push(a);
    group.slots ??= a.slots;
  } else {
    groups.push({
      id,
      name: a.location_id ? label(a.location_id) : (actions[a.action] ?? label(a.action)),
      kind: a.location_id ? (actions[a.action] ?? label(a.action)) : undefined,
      slots: a.slots,
      list: [a],
    });
  }
}
const itemCount = (g: Group) => g.list.reduce((n, a) => n + (a.items?.length ?? 0), 0);
const itemName = (item: Pick<LoginItem, "recipe_id" | "resource_id">) =>
  label(item.recipe_id ?? item.resource_id ?? "?");
---

<Base lang={lang} title={pageTitle}>
  <section class="card p-5 sm:p-6">
    <div class="flex flex-wrap items-center justify-between gap-4">
      <h1 class="text-3xl sm:text-4xl">
        <span class="text-gradient">{title}</span>
      </h1>
      <nav class="flex items-center gap-2" aria-label={t.nav}>
        {prev ? (
          <a
            href={levelPath(prev)}
            class="icon-btn"
            aria-label={fill(t.prev, { n: prev })}
            title={fill(t.prev, { n: prev })}
          >
            <Icon name="lucide:chevron-left" class="size-4" aria-hidden="true" />
          </a>
        ) : (
          <span class="icon-btn opacity-40" aria-hidden="true">
            <Icon name="lucide:chevron-left" class="size-4" />
          </span>
        )}
        <LevelPicker
          client:load
          compact
          levels={levels}
          base={localePath(lang, "levels/")}
          current={level}
          suffix={suffix}
          labels={{ label: c.picker.label, show: c.picker.show }}
        />
        {next ? (
          <a
            href={levelPath(next)}
            class="icon-btn"
            aria-label={fill(t.next, { n: next })}
            title={fill(t.next, { n: next })}
          >
            <Icon name="lucide:chevron-right" class="size-4" aria-hidden="true" />
          </a>
        ) : (
          <span class="icon-btn opacity-40" aria-hidden="true">
            <Icon name="lucide:chevron-right" class="size-4" />
          </span>
        )}
      </nav>
    </div>
    <dl class="mt-5 grid grid-cols-3 gap-3" data-testid="key-figures">
      {keys.map((k) => (
        <div class="tile flex items-center gap-3">
          <Icon name={k.icon} class="hidden size-6 shrink-0 text-accent sm:block" aria-hidden="true" />
          <div>
            <dt class="muted text-xs sm:text-sm">{k.name}</dt>
            <dd class="font-display text-2xl font-semibold">{k.value}</dd>
          </div>
        </div>
      ))}
    </dl>
    <nav class="mt-5" aria-label={t.tabs}>
      <ul class="nav-pill flex w-fit" data-testid="tabs">
        {tabs.map((x) => (
          <li>
            <a href={tabPath(level, x.id)} class="nav-link" aria-current={x.id === tab ? "page" : undefined}>
              <Icon name={x.icon} class="size-4" aria-hidden="true" />
              {x.name}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </section>

  {tab === "layout" && (
    <section class="card mt-8 p-4 sm:p-6" aria-labelledby="layout">
      <h2 id="layout" class="section-title text-2xl">
        {t.layout}
      </h2>
      {notPlaced.length > 0 && (
        <p class="warning mt-4" data-testid="not-placed">
          {fill(t.notPlaced, { n: notPlaced.length, names: notPlaced.join(", ") })}
        </p>
      )}
      <div class="mt-4">
        <FarmView
          client:load
          map={loadMap()}
          layout={comb.layout.blocks}
          blocks={comb.blocks}
          flows={comb.flow_links}
          locale={lang === "hu" ? "hu-HU" : "en-GB"}
          labels={{
            map: fill(t.layoutAlt, { n: level }),
            hint: t.mapHint,
            zoomIn: t.zoomIn,
            zoomOut: t.zoomOut,
            reset: t.resetView,
            reserved: t.reserved,
            blocks: t.blocks,
            blockFields: t.blockFields,
            notPlacedTag: t.notPlacedTag,
            details: t.details,
            close: t.closeDetails,
            busy: t.busy,
            perHour: t.perHour,
            reservedCopies: t.reservedCopies,
            fieldsReserved: t.fieldsReserved,
            flowsIn: t.flowsIn,
            flowsOut: t.flowsOut,
            notPlacedDetail: t.notPlacedDetail,
          }}
        />
      </div>
      <a href={svg} download class="mt-2 inline-flex items-center gap-2 text-sm" data-testid="layout-download">
        <Icon name="lucide:download" class="size-4" aria-hidden="true" />
        {t.download}
      </a>
    </section>
  )}

  {tab === "layout" && (
    <section class="card reveal mt-8 p-4 sm:p-6" aria-labelledby="plan-brief" data-testid="plan-brief">
      <h2 id="plan-brief" class="section-title text-2xl">
        {t.planBrief}
      </h2>
      <dl class="mt-4 grid gap-3 sm:grid-cols-3">
        {brief.map(([name, value]) => (
          <div class="tile">
            <dt class="muted text-sm">{name}</dt>
            <dd class="font-display text-xl font-semibold">{value}</dd>
          </div>
        ))}
      </dl>
      <a href={tabPath(level, "plan")} class="btn btn-primary mt-4 inline-flex items-center gap-2">
        {t.openPlan}
        <Icon name="lucide:arrow-right" class="size-4" aria-hidden="true" />
      </a>
    </section>
  )}

  {tab === "plan" && (
    <section class="card reveal mt-8 p-4 sm:p-6" aria-labelledby="summary" data-testid="plan-summary">
      <h2 id="summary" class="section-title text-2xl">
        {t.plan}
      </h2>
      <dl class="mt-4 grid grid-cols-2 gap-3 lg:grid-cols-5">
        {figures.map(([name, value]) => (
          <div class="tile">
            <dt class="muted text-sm">{name}</dt>
            <dd class="font-display text-xl font-semibold">{value}</dd>
          </div>
        ))}
      </dl>
      <h3 class="mt-5 text-lg">{t.loginTimes}</h3>
      <ol class="item-list mt-2" data-testid="login-times">
        {s.login_times.map((time) => (
          <li class="item">
            <time>{time}</time>
          </li>
        ))}
      </ol>
      {s.last_login && s.last_login.items.length > 0 && (
        <>
          <h3 class="mt-5 text-lg">{fill(t.lastLogin, { time: s.last_login.time })}</h3>
          <ul class="item-list mt-2" data-testid="last-login">
            {s.last_login.items.map((item) => (
              <li class="item">
                {itemName(item)}
                {item.location_id && <span class="every">{label(item.location_id)}</span>}
                <b>{hours(item.hours, lang)}</b>
              </li>
            ))}
          </ul>
        </>
      )}
      {trees.length > 0 && (
        <p class="mt-5">
          {t.trees} {trees.map(([id, tree]) => `${label(id)} ${tree.plants}`).join(", ")}.
        </p>
      )}
      {external.length > 0 && (
        <p class="mt-2">
          {t.external} {external.map(([id, n]) => `${label(id)} ${number(n, lang)}`).join(", ")}.
        </p>
      )}
    </section>
  )}

  {tab === "plan" && (
    <section class="reveal mt-10" aria-labelledby="logins">
      <h2 id="logins" class="section-title text-2xl">
        {t.logins}
      </h2>
      <p class="muted mt-2">{t.loginsHint}</p>
      <ol class="mt-5 grid gap-3" data-testid="login-groups">
        {groups.map((g, i) => (
          <li>
            <details class="card login-group" data-group={g.id}>
              <summary class="flex cursor-pointer items-center gap-3 p-4">
                <span class="step-no shrink-0">{i + 1}</span>
                <span class="min-w-0 grow">
                  <span class="font-display text-lg font-semibold">{g.name}</span>
                  <span class="muted block text-sm">
                    {[
                      g.kind,
                      g.slots ? fill(t.slots, { n: g.slots }) : "",
                      itemCount(g) ? fill(t.items, { n: itemCount(g) }) : "",
                    ]
                      .filter(Boolean)
                      .join(" · ")}
                  </span>
                </span>
                <Icon name="lucide:chevron-down" class="chevron size-5 shrink-0" aria-hidden="true" />
              </summary>
              <div class="px-4 pb-4">
                {g.list.map((a) => (
                  <div class="mt-2 first:mt-0">
                    {g.list.length > 1 && <p class="font-semibold">{actions[a.action] ?? label(a.action)}</p>}
                    {a.what && <p>{whats[a.what] ?? a.what}</p>}
                    {a.items && (
                      <ul class="item-list mt-2">
                        {a.items.map((item) => (
                          <li class="item">
                            {itemName(item)} <b>{item.count ?? item.per_login}</b>
                            {item.every_n_logins && (
                              <span class="every">{fill(t.everyN, { n: item.every_n_logins })}</span>
                            )}
                          </li>
                        ))}
                      </ul>
                    )}
                  </div>
                ))}
              </div>
            </details>
          </li>
        ))}
      </ol>
    </section>
  )}

  {tab === "layout" && comb.expansion.upcoming.length > 0 && (
    <section class="card reveal mt-8 p-4 sm:p-6" aria-labelledby="upcoming">
      <h2 id="upcoming" class="section-title text-2xl">
        {fill(t.upcoming, { n: comb.expansion.lookahead_levels })}
      </h2>
      <ul class="item-list mt-4">
        {comb.expansion.upcoming.map((u) => (
          <li class="item">
            {fill(t.upcomingItem, { level: u.unlock_level, name: label(u.location_id), count: u.count })}
          </li>
        ))}
      </ul>
    </section>
  )}

  {next && (
    <a href={levelPath(next)} class="tile mt-8 flex items-center justify-between gap-4" data-testid="next-level">
      <span>
        <span class="font-display text-xl font-semibold">{fill(t.nextLevel, { n: next })}</span>
        <span class="muted mt-1 block text-sm">{t.nextLevelText}</span>
      </span>
      <Icon name="lucide:arrow-right" class="size-6 shrink-0 text-accent" aria-hidden="true" />
    </a>
  )}
</Base>

<style>
  .login-group summary {
    list-style: none;
  }
  .login-group summary::-webkit-details-marker {
    display: none;
  }
  .login-group .chevron {
    color: var(--muted);
    transition: transform 0.2s;
  }
  .login-group[open] .chevron {
    transform: rotate(180deg);
  }
  .login-group summary:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
    border-radius: inherit;
  }
  @media (prefers-reduced-motion: reduce) {
    .login-group .chevron {
      transition: none;
    }
  }
</style>
